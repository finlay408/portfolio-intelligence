# ---- Database (Neon or Supabase, free tier) --------------------------------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Cron / job auth -------------------------------------------------------
# Long random string. GitHub Actions sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=

# ---- Auth (only needed if not using Vercel Deployment Protection) ----------
# Comma-free single address. Anything else is rejected at the session layer.
OWNER_EMAIL=
AUTH_SECRET=

# ---- Market data providers (all free tiers) --------------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=

# Yahoo, exchangerate.host and the Ken French library need no key.
